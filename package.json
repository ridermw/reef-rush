{
  "name": "reef-rush",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:test": "cross-env VITE_TEST_HOOKS=true npm run build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:bootstrap": "node --test tests/bootstrap/lockfile.test.mjs",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "assets:validate": "node tools/validate-assets.mjs",
    "validate": "npm run test:bootstrap && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run assets:validate && npm run build"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.4.2",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "cross-env": "10.1.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
